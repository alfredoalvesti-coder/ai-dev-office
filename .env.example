# Copie para .env. Forneça POSTGRES_PASSWORD no ambiente do terminal.
POSTGRES_DB=ai_dev_office
POSTGRES_USER=office
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
APP_USERNAME=office
APP_PASSWORD=
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ai_dev_office
SPRING_FLYWAY_DEFAULT_SCHEMA=public
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
AI_OUTPUT_TOKEN_LIMIT=1200
AI_TIMEOUT_SECONDS=180
AI_MAX_ATTEMPTS=3
AI_APPROVAL_HOURS=24
TEAM_OUTPUT_TOKEN_LIMIT=800
TEAM_MAX_ATTEMPTS=3
TEAM_CONTEXT_VERSION=team-workflow-v1
APP_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
